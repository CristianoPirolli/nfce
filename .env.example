# Copie este arquivo para .env e preencha cada valor.
# Nunca commite o .env real.

# Gere com: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=

# true em desenvolvimento, false em produção
DJANGO_DEBUG=true

# Lista separada por vírgula
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Gere com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Trocar essa chave invalida TODAS as senhas de certificados já cadastradas.
CERT_SECRET_KEY=

# Pasta raiz para gravação dos XMLs capturados.
# Aceita caminho local (C:/nfce_xmls) ou UNC (\\servidor\share\nfce).
# Vazio = não grava em disco (mantém só no banco).
NFCE_XML_ROOT=

# Postgres — DB_HOST vazio = usa SQLite local (dev).
DB_HOST=
DB_PORT=5432
DB_NAME=nfce
DB_USER=
DB_PASSWORD=
